{
  "name": "mtg-tool",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build",
    "tauri:build:release": "node scripts/build-signed-release.cjs",
    "download:node": "node scripts/download-portable-node.cjs",
    "build:tauri-standalone": "node scripts/download-portable-node.cjs && next build && node scripts/strip-standalone-bloat.cjs && node scripts/copy-tauri-assets.cjs && node scripts/prepare-tauri-resources.cjs",
    "sync:oracle": "node scripts/sync-scryfall-oracle.cjs",
    "sync:scryfall-bulk": "node scripts/sync-scryfall-bulk.cjs",
    "sync:local-data": "npm run sync:oracle && npm run refresh-tokens",
    "refresh-tokens": "node scripts/generate-token-names.cjs",
    "refresh-card-names": "node scripts/generate-card-names.cjs",
    "check:decks": "node scripts/check-deck-library.cjs",
    "check:oracle": "node scripts/check-local-oracle.cjs",
    "check:engine": "node scripts/check-engine-library.cjs",
    "check:symbolic-engine": "node scripts/check-symbolic-engine.cjs",
    "build:rules-index": "node scripts/build-rules-index.cjs",
    "generate:arbiter-suite": "node scripts/generate-arbiter-expanded-suite.cjs",
    "import:rulesguru": "node scripts/import-rulesguru-suite.cjs",
    "validate:arbiter": "node scripts/validate-arbiter-knowledge.cjs",
    "check:power-ranker": "node scripts/check-power-ranker.cjs",
    "clean:next": "node scripts/clean-next-cache.cjs",
    "check": "npm run clean:next && next build",
    "build": "npm run clean:next && next build",
    "build:oracle-index": "node scripts/build-oracle-index.cjs",
    "build:printings-index": "node scripts/build-collection-printings-index.cjs",
    "backup": "node scripts/backup-data.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "next start",
    "sync:spellbook": "node scripts/sync-spellbook.cjs",
    "sync:spellbook-cards": "node scripts/sync-spellbook.cjs --cards-only",
    "sync:edhrec-salt": "node scripts/sync-edhrec-salt.cjs",
    "sync:edhrec-salt-all": "node scripts/sync-edhrec-salt.cjs --all"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.26",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "vitest": "^4.1.7"
  }
}
