# Anthropic API — only needed for manual fallback (click "Retry with Anthropic" on an error)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local model provider (default: ollama — free, local, no API key needed)
MTG_MODEL_PROVIDER=ollama

# Ollama setup:
#   1. Install from https://ollama.com
#   2. Run: ollama serve
#   3. Pull the models:
#      ollama pull qwen2.5:32b
#      ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=32768

# Set to true to automatically fall back to Anthropic when Ollama fails.
# Recommended: leave false — use the manual "Retry with Anthropic" button instead.
ALLOW_ANTHROPIC_AUTO_FALLBACK=false
