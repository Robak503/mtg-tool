exports[`LearnView render fingerprint — markup must not change when a panel moves > TutorSearchPanel renders identically 1`] = `"<div style="display:flex;flex-direction:column;gap:12px;height:100%"><div style="padding:12px 14px;background:var(--ley-green-faint);border:1px solid var(--ley-line-bright);border-radius:6px"><div style="font-size:13px;font-weight:700;color:var(--ley-green)">🔍 Search your library — S</div><div style="font-size:12.5px;color:var(--ley-text);line-height:1.5;margin-top:4px">Choose a card to put into your hand (2 matches). Then your library is shuffled.</div></div><div style="flex:1;overflow-y:auto;display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start"><button title="Island" style="display:flex;flex-direction:column;gap:4px;padding:4px;background:transparent;border:2px solid var(--ley-line);border-radius:8px;cursor:pointer;text-align:left"><img src="/api/card-image?name=Island" alt="Island" loading="lazy" style="width:100%;aspect-ratio:63 / 88;object-fit:cover;border-radius:4px;background:var(--ley-surface-2)"/><div style="font-size:11px;color:var(--ley-text);line-height:1.25;font-weight:400">Island</div></button><button title="Mountain" style="display:flex;flex-direction:column;gap:4px;padding:4px;background:transparent;border:2px solid var(--ley-line);border-radius:8px;cursor:pointer;text-align:left"><img src="/api/card-image?name=Mountain" alt="Mountain" loading="lazy" style="width:100%;aspect-ratio:63 / 88;object-fit:cover;border-radius:4px;background:var(--ley-surface-2)"/><div style="font-size:11px;color:var(--ley-text);line-height:1.25;font-weight:400">Mountain</div></button></div><div style="display:flex;gap:8px"><button class="btn btn-primary btn-sm" style="flex:1" disabled="">Put in hand</button><button class="btn btn-ghost btn-sm">Find nothing</button></div></div>"`;

exports[`LearnView render fingerprint — markup must not change when a panel moves > UnresolvedPanel renders identically 1`] = `"<div style="display:flex;flex-direction:column;gap:12px"><div style="padding:12px 14px;background:var(--ley-green-faint);border:1px solid var(--ley-line-bright);border-radius:6px;display:flex;flex-direction:column;gap:6px"><div style="font-size:13px;font-weight:700;color:var(--ley-green)">⚖ Rules check — C</div><div style="font-size:12.5px;color:var(--ley-text);line-height:1.5">The simulator can’t fully model this card yet, so rather than guess it asked the Arbiter (the local rules engine) for a ruling. Read it, apply it on your board if you like, then continue.</div></div><div style="padding:12px 14px;background:var(--ley-surface-2);border:1px solid var(--ley-line);border-radius:6px;min-height:60px"><div style="font-size:12px;color:var(--ley-text-dim);font-style:italic">Asking the Arbiter…</div></div><button class="btn btn-primary btn-sm" style="align-self:flex-start">Continue playing</button></div>"`;

