exports[`LearnView render fingerprint — markup must not change when a panel moves > MulliganPanel renders identically 1`] = `"<link rel="preload" as="image" href="/api/card-image?name=Island"/><link rel="preload" as="image" href="/api/card-image?name=Mountain"/><link rel="preload" as="image" href="/api/card-image?name=Forest"/><div style="flex:1;overflow-y:auto;padding:22px 20px 30px;display:flex;flex-direction:column;gap:16px"><div style="text-align:center"><div style="font-size:15px;font-weight:700;color:var(--ley-text)">Mulligan</div><div style="font-size:12px;color:var(--ley-text-dim);margin-top:4px">Keep your opening seven, or ship it back for a new hand (London mulligan).</div></div><div style="display:flex;justify-content:center;align-items:flex-end;padding-left:46px;min-height:260px"><div title="Island" style="width:132px;margin-left:-46px;transform-origin:bottom center;transform:rotate(-4.5deg) translateY(9px);transition:transform 140ms ease;border-radius:9px;overflow:hidden;cursor:default;box-shadow:0 6px 18px rgba(0,0,0,0.45);background:var(--ley-surface-2);opacity:1"><div style="position:relative;aspect-ratio:63 / 88;border:1px solid var(--ley-line);border-radius:9px"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;font-size:11.5px;line-height:1.3;color:var(--ley-text)">Island</div><img src="/api/card-image?name=Island" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:9px"/></div></div><div title="Mountain" style="width:132px;margin-left:-46px;transform-origin:bottom center;transform:rotate(0deg) translateY(0px);transition:transform 140ms ease;border-radius:9px;overflow:hidden;cursor:default;box-shadow:0 6px 18px rgba(0,0,0,0.45);background:var(--ley-surface-2);opacity:1"><div style="position:relative;aspect-ratio:63 / 88;border:1px solid var(--ley-line);border-radius:9px"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;font-size:11.5px;line-height:1.3;color:var(--ley-text)">Mountain</div><img src="/api/card-image?name=Mountain" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:9px"/></div></div><div title="Forest" style="width:132px;margin-left:-46px;transform-origin:bottom center;transform:rotate(4.5deg) translateY(9px);transition:transform 140ms ease;border-radius:9px;overflow:hidden;cursor:default;box-shadow:0 6px 18px rgba(0,0,0,0.45);background:var(--ley-surface-2);opacity:1"><div style="position:relative;aspect-ratio:63 / 88;border:1px solid var(--ley-line);border-radius:9px"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;font-size:11.5px;line-height:1.3;color:var(--ley-text)">Forest</div><img src="/api/card-image?name=Forest" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:9px"/></div></div></div><div style="display:flex;justify-content:center;align-items:center;gap:10px"><button class="btn btn-primary" style="min-width:120px">Keep</button><button class="btn btn-secondary" style="min-width:120px">Ship</button></div></div>"`;

exports[`LearnView render fingerprint — markup must not change when a panel moves > OptionalChoicePanel renders identically 1`] = `"<div style="display:flex;flex-direction:column;gap:12px"><div style="font-size:14px;font-weight:600;color:var(--ley-text)">You may…</div><div style="font-size:13px;color:var(--ley-text-dim);line-height:1.5">This effect lets you <strong style="color:var(--ley-green)">apply this effect</strong>. Do it?</div><div style="display:flex;gap:10px"><button class="btn btn-primary btn-sm" style="flex:1">Yes, do it</button><button class="btn btn-ghost btn-sm" style="flex:1">No, skip</button></div></div>"`;

