set:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;font-size:11.5px;line-height:1.3;color:var(--ley-text)">Mountain</div><img src="/api/card-image?name=Mountain" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:9px"/></div></div><div title="Forest" style="width:132px;margin-left:-46px;transform-origin:bottom center;transform:rotate(4.5deg) translateY(9px);transition:transform 140ms ease;border-radius:9px;overflow:hidden;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,0.45);background:var(--ley-surface-2);opacity:1"><div style="position:relative;aspect-ratio:63 / 88;border:1px solid var(--ley-line);border-radius:9px"><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px;font-size:11.5px;line-height:1.3;color:var(--ley-text)">Forest</div><img src="/api/card-image?name=Forest" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:9px"/></div></div></div><div style="display:flex;justify-content:center;align-items:center;gap:10px"><button class="btn btn-primary" style="min-width:180px" disabled="">Bottom 0/2 &amp; play</button></div></div>"`;
