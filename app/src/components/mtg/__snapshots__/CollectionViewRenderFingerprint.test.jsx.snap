// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CollectionView render fingerprint — markup must not change when a panel moves > BulkActionBar renders identically 1`] = `"<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:8px 20px;background:var(--ley-surface-2);border-bottom:1px solid var(--ley-line)"><span style="font-size:13px;color:var(--ley-green);font-weight:600;min-width:90px">3 selected</span><button class="btn btn-secondary btn-sm" title="Select all cards matching the current filters">Select all 42</button><button class="btn btn-ghost btn-sm">Clear</button><div style="flex:1"></div><select style="background:transparent;border:1px solid var(--ley-line);color:var(--ley-text);padding:5px 12px;border-radius:4px;font-size:12px;cursor:pointer;font-family:var(--font-body), sans-serif;opacity:1" title="Assign a color tag to the selected cards"><option value="" disabled="" selected="">Assign tag ▾</option><option value="t1">Foils</option><option value="__none">— Clear tag —</option></select><select style="background:transparent;border:1px solid var(--ley-line);color:var(--ley-text);padding:5px 12px;border-radius:4px;font-size:12px;cursor:pointer;font-family:var(--font-body), sans-serif;opacity:1" title="Set the condition of the selected cards"><option value="" disabled="" selected="">Set condition ▾</option><option value="NM">NM</option><option value="LP">LP</option><option value="MP">MP</option><option value="HP">HP</option><option value="DMG">DMG</option></select><button class="btn btn-secondary btn-sm" title="Mark selected wishlist cards as owned">Mark owned</button><button class="btn btn-danger btn-sm" style="margin-left:4px">Delete (3)</button><button class="btn btn-primary btn-sm" style="margin-left:10px">Done</button></div>"`;

exports[`CollectionView render fingerprint — markup must not change when a panel moves > CenterMessage renders identically 1`] = `"<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--ley-text-dim);font-size:14px">Loading collection…</div>"`;

exports[`CollectionView render fingerprint — markup must not change when a panel moves > ConflictsModal renders identically 1`] = `"<div style="position:fixed;inset:0;background:rgba(0,0,0,0.55);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:100"><div class="ley-glass-strong ley-glass-lit" style="width:560px;max-width:calc(100vw - 40px);max-height:calc(100vh - 80px);display:flex;flex-direction:column;color:var(--ley-text)"><header style="padding:14px 18px;border-bottom:1px solid var(--ley-line);display:flex;justify-content:space-between;align-items:center"><div><div style="font-size:14px;color:var(--ley-text);font-weight:500;font-family:var(--font-display)">Cross-deck conflicts</div><div style="font-size:11px;color:var(--ley-text-dim);margin-top:2px">Across 2 decks</div></div><button aria-label="Close" class="btn btn-ghost btn-icon btn-sm">×</button></header><div style="overflow-y:auto;padding:8px 0"><div style="padding:10px 18px;border-bottom:1px solid var(--ley-line)"><div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:13px;color:var(--ley-text);font-weight:500">Sol Ring</span><span style="font-size:11px;color:var(--ley-red)">short 2 copies</span></div><div style="font-size:11px;color:var(--ley-text-dim);margin-top:3px">Owned 1 · used 3 in: Aggro, Combo</div></div></div></div></div>"`;

exports[`CollectionView render fingerprint — markup must not change when a panel moves > EmptyState renders identically 1`] = `"<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:40px;text-align:center"><div style="font-size:48px;margin-bottom:16px;opacity:0.4">📚</div><div style="font-size:16px;color:var(--ley-text);margin-bottom:8px;font-family:var(--font-display)">Your collection is empty.</div><div style="font-size:13px;color:var(--ley-text-dim);max-width:420px;line-height:1.5;margin-bottom:20px">Add cards individually or import from Deckbox / Moxfield CSV. Once you&#x27;ve added cards, every agent (Karn, Tibalt, Jace) will know what you own and tailor suggestions to your actual collection.</div><button class="btn btn-primary">+ Add your first card</button></div>"`;

exports[`CollectionView render fingerprint — markup must not change when a panel moves > HeaderOverflowMenu renders identically 1`] = `"<div style="position:relative"><button class="btn btn-primary btn-sm btn-icon" title="More actions" aria-label="More actions" aria-expanded="true">⋯</button><div class="ley-glass-strong" style="position:absolute;top:calc(100% + 6px);right:0;z-index:60;min-width:180px;padding:6px;display:flex;flex-direction:column;gap:2px;border:1px solid var(--ley-line);border-radius:var(--r-lg)"><button class="btn btn-ghost btn-sm" title="Export the collection" style="justify-content:flex-start;text-align:left;width:100%;white-space:nowrap">Export CSV</button><button class="btn btn-ghost btn-sm" title="Delete everything" style="justify-content:flex-start;text-align:left;width:100%;white-space:nowrap;color:var(--ley-red)">Delete all</button></div></div>"`;

exports[`CollectionView render fingerprint — markup must not change when a panel moves > ShowpieceShelf renders identically 1`] = `"<div style="padding:14px 20px 4px;border-bottom:1px solid var(--ley-line)"><div style="font-family:var(--font-mono), monospace;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ley-green);margin-bottom:10px;text-shadow:0 0 8px var(--ley-green-glow)">★ The Showpiece Shelf</div><div style="display:flex;gap:16px;overflow-x:auto;padding-bottom:12px"><button class="ley-card" style="flex-shrink:0;width:240px;text-align:left;cursor:pointer;background:var(--ley-glass);border:1px solid var(--ley-line-bright);border-radius:var(--r-lg);padding:8px;color:var(--ley-text);box-shadow:0 0 18px var(--ley-green-glow)" title="Signed Bear — Signed — R. Artist (in person) · MagicCon · 2026"><img src="/api/card-image?id=sc-1" alt="" width="224" height="313" loading="lazy" style="object-fit:cover;border-radius:11px;display:block;border:1px solid var(--ley-line)"/><div style="font-size:13px;font-weight:600;margin-top:7px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--font-display), sans-serif">Signed Bear</div><div style="font-size:10px;color:var(--ley-text-dim);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Signed — R. Artist (in person) · MagicCon · 2026</div></button><button class="ley-card" style="flex-shrink:0;width:240px;text-align:left;cursor:pointer;background:var(--ley-glass);border:1px solid var(--ley-line-bright);border-radius:var(--r-lg);padding:8px;color:var(--ley-text);box-shadow:0 0 18px var(--ley-green-glow)" title="Showcase Foil — Showcase"><img src="/api/card-image?id=sc-2" alt="" width="224" height="313" loading="lazy" style="object-fit:cover;border-radius:11px;display:block;border:1px solid var(--ley-line)"/><div style="font-size:13px;font-weight:600;margin-top:7px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--font-display), sans-serif">Showcase Foil</div><div style="font-size:10px;color:var(--ley-text-dim);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Showcase</div></button></div></div>"`;
