{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MTG Tool",
  "version": "0.13.0",
  "identifier": "com.colton.mtg-tool",
  "build": {
    "frontendDist": "frontend-placeholder",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri-standalone"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MTG Tool",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQzQ1RDVFMzkzQTEwMkUKUldRdUVEbzVYbDNFSWI5WHdOOU5GN25SRVdUNDR6dDJRempEM2VIV1ZHcFdRczMvRGF0NGI1WHkK",
      "endpoints": [
        "https://github.com/Robak503/mtg-tool/releases/latest/download/latest.json"
      ]
    }
  }
}
