{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Omnath MTG Assistant",
  "version": "0.1.0",
  "identifier": "com.colton.omnath.probe",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:android-assets"
  },
  "app": {
    "windows": [
      {
        "title": "Omnath MTG Assistant",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../build/knowledge/omnath-knowledge.sqlite": "knowledge/omnath-knowledge.sqlite",
      "../build/knowledge/omnath-knowledge.manifest.json": "knowledge/omnath-knowledge.manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
