{
  "name": "omnath-webview-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:android-assets": "npm run knowledge:build && npm run build",
    "knowledge:build": "node --no-warnings scripts/build-knowledge-pack.mjs",
    "knowledge:test": "node --no-warnings --test tests/knowledge-pack.test.mjs",
    "knowledge:parity": "node --no-warnings scripts/verify-knowledge-parity.mjs",
    "repository:test": "node --no-warnings --test tests/knowledge-repository.test.mjs",
    "answer:test": "node --no-warnings --test tests/answer-planner.test.mjs tests/narration-contract.test.mjs tests/interpretation-contract.test.mjs tests/assistant-controller.test.mjs tests/feedback-diagnostics.test.mjs",
    "test": "npm run knowledge:test && npm run repository:test && npm run answer:test",
    "shell:test": "node --no-warnings --test tests/security-accessibility.test.mjs",
    "verify": "npm test && npm run shell:test && npm run knowledge:parity && npm run build",
    "tauri": "tauri",
    "android:init": "tauri android init --ci --skip-targets-install",
    "android:build:debug": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "android:model:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-android-model.ps1",
    "models:stage": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-models.ps1",
    "models:push": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/push-models-to-device.ps1",
    "device:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/device-verify.ps1",
    "receipt": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-build-receipt.ps1",
    "release:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-candidate.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-sql": "2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "vite": "8.2.2"
  }
}
