# Dependencies
node_modules/
.pnp
.pnp.js

# Local Claude Code tooling state (auto-created preview launch config, session
# state). Not project config — kept local so it can't be committed by accident.
# EXCEPTION: .claude/commands/ holds shared project slash commands (e.g. /omnath)
# that must be committed so they load in Claude Code web/phone sessions, which
# only see repo content. .claude/settings.json is also committed (shared hooks +
# permissions); machine-specific overrides + secrets stay in settings.local.json.
.claude/*
!.claude/commands/
!.claude/settings.json

# Agent scratch / sandbox dirs (auto-created by /cso, /codex, CTO-review runs and
# similar — duplicate-source scratch + debug scripts). NEVER commit (a stray
# `.cto_sandbox/` was 41k untracked lines tempting a "Create PR" against master).
.cto_sandbox/
.claire/

# Stray root-level scratch/debug probes. Coverage-grind sessions write ad-hoc
# *.mjs sanity probes; a `git add -A` from the repo root once swept `cntprobe.mjs`
# onto master. Real code lives under app/ (app/scripts/*.mjs is legit), so a
# ROOT-ANCHORED guard blocks accidental probes without touching tracked scripts.
/*.mjs
/*.cjs

# Next.js
app/.next/
app/out/

# Production
build/
dist/

# Environment — NEVER commit these
.env
.env.local
.env.production.local
.env*.local

# Logs
*.log
local-dev.*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Scryfall bulk data (huge — regenerable from sync)
app/data/scryfall-bulk/*.json
app/data/scryfall-bulk/indexes/
app/data/scryfall.oracle.local.json
app/data/scryfall.rulings.local.json
app/data/rules-index.json
app/data/cardkingdom-prices.json
app/reports/

# User data — IGNORED. Decks, chats, and agent notes are the user's own content:
# they live in %APPDATA% in production and are local-only in dev. The app
# auto-seeds a starter deck on first launch (CLAUDE.md §5 #7), so NO seed file is
# committed. (These also match app/.gitignore's `data/*.local.json` rule, which
# takes precedence inside app/ — the earlier "!" un-ignore here was dead.)
app/data/decks.local.json
app/data/chats.local.json
app/data/agent-notes.local.json

# First-launch sentinel — runtime marker, written to %APPDATA% in production and
# to app/data/ in dev (CLAUDE.md §5 #7 / gotcha #7). Never commit it.
app/data/.first-launch-marker.json

# Local provider/cost telemetry (regenerable and private)
app/data/model-calls.local.json

# Legacy ENGINE scryfall fragments (large — already in bulk)
knowledge/mtg-engine/scryfall_*.json

# Backups (local snapshots from npm run backup)
app/data/backups/
app/data/*.bak
app/data/*.corrupted

# In-app feedback captures (local-only, contain user notes about their own usage)
app/data/feedback/

# Goldfish game records (local-only, regenerable by re-running Garfield)
app/data/games/

# Self-play crucible logs + trajectories (local-only evidence, regenerable by re-running the harness)
app/data/self-play/

# Collection feature — user data + regenerable caches (live in %APPDATA% in prod)
app/data/collection.json
app/data/watchlist.json
app/data/price-alerts.json
app/data/collection-prices.jsonl
app/data/collection-prices.compact.jsonl
app/data/collection-roasts.json
app/data/collection.broken-*.json
app/data/art-crops/
# Full-card image proxy cache (/api/card-image — regenerable from Scryfall)
app/data/card-images/

# Embedded repos (Forge clone and RulesGuru repo — not submodules)
knowledge/mtg-judge/data/forge/
knowledge/mtg-judge/data/rulesguru-repo/

# Sensitive plaintext files
"knowledge/mtg-engine/THE KEY.txt"
knowledge/mtg-engine/THE KEY.txt

# Python artifacts
__pycache__/
*.pyc
*.pyo
.gstack/
