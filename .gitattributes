# Normalize line endings: store as LF in the repo. Stops the "LF will be
# replaced by CRLF" churn on this Windows-first project.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts.
*.sh   text eol=lf

# Known binaries: never normalize or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.exe   binary
*.dll   binary
*.sig   binary
*.docx  binary
*.pdf   binary
